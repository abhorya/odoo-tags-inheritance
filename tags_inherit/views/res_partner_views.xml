<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View -->
    <record id="view_res_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="company_tag"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Tree View -->
     <record id="view_res_partner_tree_inherit" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="company_tag"/>
            </field>
        </field>
    </record>

    <!-- Partner Search View -->
    <record id="view_res_partner_search_inherit" model="ir.ui.view">
        <field name="name">res.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="company_tag"/>
            </field>
            <filter name="customer" position="after">
                <filter string="My Customer Tags" name="my_customer_tags" 
                        domain="[('has_my_customer_tag', '=', True)]"/>
                <filter string="My Vendor Tags" name="my_vendor_tags" 
                        domain="[('has_my_vendor_tag', '=', True)]"/>
                <separator/>
            </filter>
            <filter name="group_country" position="after">
                <filter string="Company Tag" name="group_company_tag" context="{'group_by': 'company_tag'}"/>
            </filter>
        </field>
    </record>
</odoo>
