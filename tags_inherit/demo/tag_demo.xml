<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Customer Tags -->
        <record id="customer_tag_premium" model="crm.tag">
            <field name="name">Premium Customer</field>
            <field name="tag_type">customer</field>
            <field name="color">1</field>
        </record>

        <record id="customer_tag_vip" model="crm.tag">
            <field name="name">VIP Customer</field>
            <field name="tag_type">customer</field>
            <field name="color">2</field>
        </record>

        <record id="customer_tag_regular" model="crm.tag">
            <field name="name">Regular Customer</field>
            <field name="tag_type">customer</field>
            <field name="color">3</field>
        </record>

        <!-- Vendor Tags -->
        <record id="vendor_tag_preferred" model="crm.tag">
            <field name="name">Preferred Vendor</field>
            <field name="tag_type">vendor</field>
            <field name="color">4</field>
        </record>

        <record id="vendor_tag_certified" model="crm.tag">
            <field name="name">Certified Vendor</field>
            <field name="tag_type">vendor</field>
            <field name="color">5</field>
        </record>

        <!-- Product Tags -->
        <record id="product_tag_bestseller" model="crm.tag">
            <field name="name">Bestseller</field>
            <field name="tag_type">product</field>
            <field name="color">6</field>
        </record>

        <record id="product_tag_new" model="crm.tag">
            <field name="name">New Arrival</field>
            <field name="tag_type">product</field>
            <field name="color">7</field>
        </record>

        <record id="product_tag_sale" model="crm.tag">
            <field name="name">On Sale</field>
            <field name="tag_type">product</field>
            <field name="color">8</field>
        </record>

        <!-- Demo Users with Tag Access -->
        <record id="sales_user_demo" model="res.users">
            <field name="name">Sales Demo User</field>
            <field name="login">sales.demo@example.com</field>
            <field name="password">demo123</field>
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="allowed_customer_tags" eval="[(4, ref('customer_tag_regular')), (4, ref('customer_tag_premium'))]"/>
            <field name="allowed_product_tags" eval="[(4, ref('product_tag_bestseller')), (4, ref('product_tag_sale'))]"/>
        </record>

        <record id="purchase_user_demo" model="res.users">
            <field name="name">Purchase Demo User</field>
            <field name="login">purchase.demo@example.com</field>
            <field name="password">demo123</field>
            <field name="groups_id" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="allowed_vendor_tags" eval="[(4, ref('vendor_tag_preferred')), (4, ref('vendor_tag_certified'))]"/>
            <field name="allowed_product_tags" eval="[(4, ref('product_tag_new'))]"/>
        </record>

        <!-- Demo Partners with Tags -->
        <record id="partner_demo_premium" model="res.partner">
            <field name="name">Premium Demo Customer</field>
            <field name="email">premium.demo@example.com</field>
            <field name="company_tag" ref="customer_tag_premium"/>
            <field name="customer_rank">1</field>
        </record>

        <record id="partner_demo_vendor" model="res.partner">
            <field name="name">Certified Demo Vendor</field>
            <field name="email">vendor.demo@example.com</field>
            <field name="company_tag" ref="vendor_tag_certified"/>
            <field name="supplier_rank">1</field>
        </record>

        <!-- Demo Products with Tags -->
        <record id="product_demo_bestseller" model="product.template">
            <field name="name">Demo Bestseller Product</field>
            <field name="list_price">100.00</field>
            <field name="type">product</field>
            <field name="company_tag" ref="product_tag_bestseller"/>
        </record>

        <record id="product_demo_new" model="product.template">
            <field name="name">Demo New Product</field>
            <field name="list_price">150.00</field>
            <field name="type">product</field>
            <field name="company_tag" ref="product_tag_new"/>
        </record>
    </data>
</odoo> 